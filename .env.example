# Base de datos. En Neon, DATABASE_URL es el pooler (host con -pooler) y
# DIRECT_URL es la conexión directa, solo para prisma migrate deploy.
# Ejemplo de pooler: postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://requerimientos:requerimientos@127.0.0.1:5432/requerimientos
DIRECT_URL=postgresql://requerimientos:requerimientos@127.0.0.1:5432/requerimientos

# URL pública. En Vercel o Netlify puede omitirlas: se usan VERCEL_URL,
# VERCEL_PROJECT_PRODUCTION_URL o URL. Si las define, use https:// en el dominio fijo.
APP_URL=http://127.0.0.1:38471
AUTH_URL=http://127.0.0.1:38471
AUTH_TRUST_HOST=true
AUTH_SECRET=cambie-este-secreto-por-uno-largo
PORT=38471

# Hosts extra para las server actions. Lista separada por comas. Admite comodines.
# Se une a APP_URL, AUTH_URL, VERCEL_URL, el dominio de producción y la URL de Netlify.
ALLOWED_ORIGINS=

# Primer administrador. Se crea al arrancar, o con npm run create-admin, si el correo no existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Microsoft 365 / Entra ID queda en fase 2. Déjelo en false.
AUTH_ENTRA_ENABLED=false
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# Uno o varios dominios separados por coma.
AUTH_ALLOWED_EMAIL_DOMAIN=cifes.edu.co

# true solo en desarrollo: perfiles de ejemplo sin contraseña.
DEV_AUTH_ENABLED=false

# true borra la base y carga la demostración. En producción no lo defina.
# npm run seed:inicial crea solo catálogos y el administrador.
SEED_DEMO=false

# true abre /registro. La cuenta queda pendiente de aprobación.
REGISTRO_PUBLICO=false

# Correo: console (desarrollo) o smtp
EMAIL_PROVIDER=console
EMAIL_FROM=Mesa CIFES <mesa@cifes.edu.co>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Adjuntos. local es el disco (UPLOAD_DIR). En Vercel use vercel-blob.
# En Netlify use netlify-blobs. La descarga sigue en /api/adjuntos.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Token del store privado de Vercel Blob. En Vercel suele inyectarse solo.
BLOB_READ_WRITE_TOKEN=

# Jornada hábil en America/Bogota. Varias franjas separadas por coma.
BUSINESS_WINDOWS=08:00-12:00,14:00-18:00
SLA_RISK_RATIO=0.75

# Protege GET y POST /api/cron/sla. En producción es obligatorio.
# Vercel Cron y la función programada de Netlify lo envían como Bearer.
# SLA_SCHEDULER=true solo tiene efecto fuera de Vercel y Netlify.
CRON_SECRET=
SLA_SCHEDULER=
