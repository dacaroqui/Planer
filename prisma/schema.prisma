generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SOLICITANTE
  AGENTE
  LIDER
  ADMINISTRADOR
  OBSERVADOR
}

enum Team {
  DESARROLLO
  MARKETING
}

enum Brand {
  CIFES
  LUVANIA
  AMBAS
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

model Area {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  users     User[]
  requests  Request[]
  createdAt DateTime  @default(now())
}

model RequestType {
  id               String    @id @default(cuid())
  team             Team
  name             String
  description      String
  slaMinutes       Int
  requiresApproval Boolean   @default(false)
  active           Boolean   @default(true)
  requests         Request[]
  createdAt        DateTime  @default(now())

  @@unique([team, name])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  role          Role           @default(SOLICITANTE)
  team          Team?
  areaId        String
  area          Area           @relation(fields: [areaId], references: [id])
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  requested     Request[]      @relation("Requester")
  assigned      Request[]      @relation("Assignee")
  comments      Comment[]
  activities    Activity[]
  attachments   Attachment[]
  notifications Notification[]
}

model Sequence {
  year Int @id
  last Int @default(0)
}

model Request {
  id               String       @id @default(cuid())
  code             String       @unique
  title            String
  description      String
  expectedResult   String
  brand            Brand
  priority         Priority
  team             Team
  status           String
  desiredDate      DateTime?
  typeId           String
  type             RequestType  @relation(fields: [typeId], references: [id])
  areaId           String
  area             Area         @relation(fields: [areaId], references: [id])
  requesterId      String
  requester        User         @relation("Requester", fields: [requesterId], references: [id])
  assigneeId       String?
  assignee         User?        @relation("Assignee", fields: [assigneeId], references: [id])
  resolution       String?
  slaStartedAt     DateTime
  slaTargetMinutes Int
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  comments         Comment[]
  activities       Activity[]
  attachments      Attachment[]
  pauses           SlaPause[]
  notifications    Notification[]

  @@index([status, team])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([createdAt])
}

model SlaPause {
  id        String    @id @default(cuid())
  requestId String
  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  reason    String
}

model Comment {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([requestId])
}

model Attachment {
  id           String   @id @default(cuid())
  requestId    String
  request      Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  filename     String
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  kind      String
  message   String
  fromValue String?
  toValue   String?
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([requestId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String?
  request   Request?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}
