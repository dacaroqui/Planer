generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SOLICITANTE
  AGENTE
  LIDER
  ADMINISTRADOR
  OBSERVADOR
}

enum Team {
  DESARROLLO
  MARKETING
}

model Area {
  id               String    @id @default(cuid())
  name             String    @unique
  active           Boolean   @default(true)
  allowSelfAssign  Boolean   @default(true)
  users            User[]
  requests         Request[]
  createdAt        DateTime  @default(now())
}

model RequestType {
  id          String    @id @default(cuid())
  team        Team
  name        String
  description String
  extra       String    @default("")
  active      Boolean   @default(true)
  requests    Request[]
  policies    SlaPolicy[]
  createdAt   DateTime  @default(now())

  @@unique([team, name])
}

model CatalogItem {
  id        String   @id @default(cuid())
  kind      String
  key       String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  @@unique([kind, key])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  role          Role           @default(SOLICITANTE)
  team          Team?
  areaId        String
  area          Area           @relation(fields: [areaId], references: [id])
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  areaRoles     AreaRole[]
  requested     Request[]      @relation("Requester")
  assigned      Request[]      @relation("Assignee")
  comments      Comment[]
  activities    Activity[]
  attachments   Attachment[]
  notifications Notification[]
  audits        AuditLog[]
}

model AreaRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team
  role   Role

  @@unique([userId, team, role])
}

model CodeSequence {
  prefix String @id
  last   Int    @default(0)
}

model WorkflowState {
  id            String  @id @default(cuid())
  team          Team
  key           String
  name          String
  category      String
  sortOrder     Int
  boardColumn   String
  hiddenOnBoard Boolean @default(false)
  active        Boolean @default(true)

  @@unique([team, key])
}

model WorkflowTransition {
  id                     String  @id @default(cuid())
  team                   Team
  name                   String
  fromKeys               String
  toKey                  String
  allowedRoles           String
  requiresComment        Boolean @default(false)
  requiresAssignee       Boolean @default(false)
  requiresCommittedDate  Boolean @default(false)
  requiresDelivery       Boolean @default(false)
  slaEffect              String  @default("NONE")
  resolution             String  @default("")
  clearResolution        Boolean @default(false)
  incrementRounds        Boolean @default(false)
  toPrevious             Boolean @default(false)
  reopenWithinDays       Int     @default(0)
  active                 Boolean @default(true)

  @@unique([team, name, fromKeys, toKey])
}

model SlaPolicy {
  id                     String       @id @default(cuid())
  team                   Team
  typeId                 String?
  type                   RequestType? @relation(fields: [typeId], references: [id])
  priority               String
  firstResponseMinutes   Int
  resolutionMinutes      Int
  active                 Boolean      @default(true)

  @@unique([team, typeId, priority])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

model Request {
  id                     String       @id @default(cuid())
  code                   String       @unique
  title                  String
  description            String
  expectedResult         String       @default("")
  justification          String       @default("")
  brand                  String
  priority               String
  prioritySuggested      String
  team                   Team
  status                 String
  previousStatus         String?
  desiredDate            DateTime?
  committedDate          DateTime?
  typeId                 String
  type                   RequestType  @relation(fields: [typeId], references: [id])
  areaId                 String
  area                   Area         @relation(fields: [areaId], references: [id])
  requesterId            String
  requester              User         @relation("Requester", fields: [requesterId], references: [id])
  assigneeId             String?
  assignee               User?        @relation("Assignee", fields: [assigneeId], references: [id])
  resolution             String?
  deliveryUrl            String       @default("")
  channels               String       @default("")
  publishAt              DateTime?
  adjustmentRounds       Int          @default(0)
  stepsToReproduce       String       @default("")
  moduleName             String       @default("")
  declaresNoPersonalData Boolean      @default(false)
  slaStartedAt           DateTime
  slaTargetMinutes       Int
  firstResponseMinutes   Int          @default(240)
  resolutionMinutes      Int          @default(1440)
  firstResponseDueAt     DateTime?
  firstResponseStoppedAt DateTime?
  firstResponseMet       Boolean?
  resolvedAt             DateTime?
  closedAt               DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  comments               Comment[]
  activities             Activity[]
  attachments            Attachment[]
  pauses                 SlaPause[]
  notifications          Notification[]

  @@index([status, team])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([createdAt])
}

model SlaPause {
  id        String    @id @default(cuid())
  requestId String
  request   Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  reason    String
}

model Comment {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([requestId])
}

model Attachment {
  id           String   @id @default(cuid())
  requestId    String
  request      Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  filename     String
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  kind      String
  message   String
  field     String?
  fromValue String?
  toValue   String?
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([requestId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String?
  request   Request?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}
